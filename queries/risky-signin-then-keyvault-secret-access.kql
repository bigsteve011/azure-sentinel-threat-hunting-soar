// Risky sign-in followed within 15 minutes by Key Vault secret/key reads by the same user.
// MITRE ATT&CK: T1078 (Valid Accounts) -> T1555 (Credentials from Password Stores)
let lookback = 1h;
let window = 15m;
let RiskySignins = SigninLogs
    | where TimeGenerated > ago(lookback)
    | where ResultType == "0"                                   // successful sign-ins only
    | where RiskLevelDuringSignIn in ("medium", "high")
    | project LoginTime = TimeGenerated, UserPrincipalName = tolower(UserPrincipalName),
              SigninIP = IPAddress, Location, RiskLevelDuringSignIn;
let VaultReads = AzureDiagnostics
    | where TimeGenerated > ago(lookback)
    | where ResourceProvider == "MICROSOFT.KEYVAULT"
    | where OperationName in ("SecretGet", "KeyGet", "SecretList")
    | project AccessTime = TimeGenerated, UserPrincipalName = tolower(identity_claim_upn_s),
              Vault = Resource, OperationName, VaultClientIP = CallerIPAddress;
RiskySignins
| join kind=inner VaultReads on UserPrincipalName
| where AccessTime between (LoginTime .. (LoginTime + window))
| summarize ReadCount = count(), Operations = make_set(OperationName), Vaults = make_set(Vault),
            FirstRead = min(AccessTime)
            by UserPrincipalName, LoginTime, SigninIP, Location, RiskLevelDuringSignIn
| where ReadCount >= 3
